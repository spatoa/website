[Unit]
Description=Lightweight Nginx Static Server
After=network-online.target local-fs.target static-updater.service

[Container]
AutoUpdate=registry
Image=docker.io/library/nginx:alpine

# Mount the volume to the default nginx web root
Volume=/home/spatoa/website:/usr/share/nginx/html:ro,z

PublishPort=8080:80

# --- Health Check ---
HealthCmd=wget -q --spider http://localhost:80 || exit 1
HealthInterval=30s
HealthStartPeriod=20s
HealthRetries=3

[Service]
# minimal logging to save disk I/O
ExecStartPost=/usr/bin/echo "Web server is now online"
Restart=always

[Install]
WantedBy=multi-user.target