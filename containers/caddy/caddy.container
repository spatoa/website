[Unit]
Description=Caddy Reverse Proxy
After=network-online.target

[Container]
AutoUpdate=registry
Image=docker.io/library/caddy:alpine
Network=host

# Mounts using the injected root path
Volume=/opt/caddy/Caddyfile:/etc/caddy/Caddyfile:Z
Volume=/opt/caddy/data:/data:Z
Volume=/opt/caddy/config:/config:Z

# --- Healthcheck ---
HealthCmd=wget -q -O /dev/null http://127.0.0.1:2019/metrics || exit 1
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartupInterval=5s
HealthOnFailure=kill

Notify=healthy

[Service]
Restart=always
# Reload Caddy config without restarting container
ExecReload=/usr/bin/podman exec caddy caddy reload --config /etc/caddy/Caddyfile
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target