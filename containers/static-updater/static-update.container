[Unit]
Description=Git Puller for Static Site (HTTPS)
Wants=network-online.target

[Container]
AutoUpdate=registry
Image=docker.io/alpine/git:latest

Volume=/home/spatoa/website:/data:z
Volume=/opt/static-updater/token.txt:/token:ro

# The Script Logic:
# 1. Read token from the secret file mounted by Podman
# 2. Configure git to use the token in the URL (using 'insteadOf' is a clean way to handle this without messing up the .git/config URL permanently)
# 3. Clone if empty, Pull if exists.
Entrypoint=/bin/sh
Exec=-c 'TOKEN=$(cat /token) && \
     cd /data && \
     git config --global url."https://$TOKEN@forgejo.lachlans.world/".insteadOf "https://forgejo.lachlans.world/" && \
     if cd website; then \
         git pull https://$TOKEN@forgejo.lachlans.world/spatoa/website.git; \
     else \
         git clone https://$TOKEN@forgejo.lachlans.world/spatoa/website.git .; \
     fi'

[Service]
Type=oneshot